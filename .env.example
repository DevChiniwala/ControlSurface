# Local development only. Copy to .env and replace every value.
CS_DB_PASSWORD=replace-with-a-long-random-value
CS_CH_PASSWORD=replace-with-a-long-random-value
CS_BOOTSTRAP_TOKEN=replace-with-a-long-random-value
# Optional opt-in ClickHouse trace/projection TTL in days (1..3650).
# After enabling, removing this setting does not remove an existing table TTL.
# CS_TRACE_RETENTION_DAYS=30
# For non-default web/API origins, set both and rebuild the web image.
# CS_PUBLIC_API_URL=http://localhost:8000
# CS_CORS_ORIGINS=http://localhost:3000
# CS_COOKIE_SECURE=false
